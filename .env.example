# Supabase (from your project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser
# Use the new secret key (recommended) OR legacy service_role JWT
SUPABASE_SECRET_KEY=sb_secret_your-key-here
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...legacy-service-role-jwt

# OpenRouter (server-only — powers /api/v1/chat)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=google/gemini-2.5-flash
# Fast model for greetings/small talk. Falls back to OPENROUTER_MODEL when unset.
OPENROUTER_MODEL_FAST=google/gemini-2.5-flash-lite

# Embedding model for RAG (must match vector size in Supabase — see docs/SYSTEM_EVOLUTION.md)
# Default: openai/text-embedding-3-small (1536-dim, supports an HNSW index)
# Alternative: nvidia/llama-nemotron-embed-vl-1b-v2:free (2048-dim, no index, trains on your data)
# If you change this model: update lib/embeddings.ts dimensions, migrate DB if needed, then npm run embed-knowledge
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# App URL — this developer portal (production: https://developers.tanyalahustaz.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ToyyibPay (billing — powers the Top up page, currency MYR)
# Create a category in ToyyibPay → Category, then use its code below.
# Sandbox keys come from https://dev.toyyibpay.com; production from https://toyyibpay.com
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
# sandbox (dev.toyyibpay.com) or production (toyyibpay.com)
TOYYIBPAY_ENV=sandbox
# 0 = FPX (online banking) only, 1 = credit card only, 2 = both
TOYYIBPAY_PAYMENT_CHANNEL=2
# 0 = absorb the gateway fee, 1/2 = pass it to the customer
TOYYIBPAY_CHARGE_TO_CUSTOMER=0
# Fallback payer phone (ToyyibPay's billPayorInfo requires a phone value)
TOYYIBPAY_DEFAULT_PHONE=0000000000

# Usage billing — partner charge = OpenRouter cost (USD) x (1 + markup%) x this rate.
# USD -> MYR conversion used for usage pricing.
OPENROUTER_USD_MYR_RATE=4.7

# Transactional email for low-credit alerts (optional — alerts are skipped when unset).
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender address, e.g. "Tanyalah Ustaz <alerts@tanyalahustaz.com>"
EMAIL_FROM=Tanyalah Ustaz <noreply@tanyalahustaz.com>

# Rate limiting (uses api_usage + partner_chat_logs tables — no extra service needed)
# Set RATE_LIMIT_ENABLED=false to disable locally
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=120
RATE_LIMIT_CHAT_PER_DAY=50000
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_API_PER_DAY=100000
RATE_LIMIT_PLAYGROUND_PER_MINUTE=10
RATE_LIMIT_PLAYGROUND_PER_DAY=50

# Signup access control (default: invite-only)
# Set SIGNUP_MODE=open for public registration (e.g. local dev)
SIGNUP_MODE=invite
# Comma-separated invite codes (hashed server-side for DB invites)
SIGNUP_INVITE_CODES=your-beta-invite-code

# Google Cloud Storage — read-only knowledge source (one-way sync into Supabase)
# Service account needs roles/storage.objectViewer on the bucket only.
# GCS_SERVICE_ACCOUNT_JSON accepts raw JSON or a base64-encoded copy of the key file.
GCS_BUCKET_NAME=tanyalah-ustaz-ai
GCS_SERVICE_ACCOUNT_JSON=
# Optional: folder the picker opens at by default, e.g. GCS_PREFIX=Knowledge
GCS_PREFIX=
# Max new/changed files processed per sync run (keeps requests fast)
GCS_SYNC_MAX_FILES=10
# How many files to download/extract/insert at once. Keep low (1-3): Supabase's
# pooler drops requests and times out large inserts when too many run at once.
GCS_SYNC_CONCURRENCY=2
# Max file size to read, in bytes (default 100 MB)
GCS_SYNC_MAX_BYTES=104857600
# Set to true to let the model draft title/summary/tags (costs AI tokens).
# Off by default: fields are derived from the filename and folder path.
GCS_AI_STRUCTURING=false
# Folder names skipped by the sync (images/assets)
GCS_SYNC_EXCLUDE_PREFIXES=cover-image,cover,covers
# Optional: limit the sync to certain file types (no UI for this — env only).
# Example: GCS_SYNC_EXTENSIONS=.pdf
# Leave empty to import every supported type (.pdf .docx .txt .md .html).
GCS_SYNC_EXTENSIONS=

# Sentry error monitoring (optional — leave blank to disable)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Vercel Cron secret for /api/cron/embed-jobs (set in Vercel dashboard)
CRON_SECRET=generate-a-long-random-secret

# Background embedding job batch size
EMBED_JOB_BATCH_SIZE=5

# OCR for scanned PDFs (no text layer). Runs on demand from the Sources page,
# using an OpenRouter vision model. Capped per run to protect the balance.
# gemini-2.5-flash handles Arabic/Malay well at Flash-tier cost; swap for
# google/gemini-2.5-pro if you need higher transcription accuracy.
OCR_MODEL=google/gemini-2.5-flash
OCR_MAX_FILES=5
OCR_MAX_PAGES=50
OCR_RENDER_SCALE=2.0

# Embed batch size for the embedding request batching. Each chunk is ~900 chars
# (~230 tokens), so 64 chunks keeps a request around 15k chars — comfortably
# under model limits, with a per-item fallback if one chunk is bad.
EMBED_BATCH_SIZE=64
CHUNK_INSERT_BATCH_SIZE=200

# How many embedding requests may be in flight at once. Higher = faster bulk
# embedding, but watch OpenRouter rate limits. Raise for backfills.
EMBED_CONCURRENCY=4
# How many articles to embed at once during a bulk run (in-app or the script).
EMBED_ARTICLE_CONCURRENCY=4
# Skip a chunk that still fails after all retries instead of failing the article.
EMBED_SKIP_FAILED_ITEMS=true

# Chat latency helpers.
# CHAT_TIMING=true logs per-stage timings for each chat request.
CHAT_TIMING=false
# Semantic answer cache: repeat/near-duplicate questions skip the model.
CHAT_ANSWER_CACHE=true
# How similar a cached question must be to reuse its answer (0–1).
CHAT_CACHE_SIMILARITY=0.96
# Cap reply length so answers finish sooner and cost less. 0 disables the cap.
CHAT_MAX_TOKENS=4000
# Mark the fixed system prompt for provider-side prompt caching (faster TTFT).
CHAT_PROMPT_CACHE=true
# Embedding price per 1M tokens, for the pre-sync cost estimate only.
EMBED_PRICE_PER_MILLION=0.02

# Minimum similarity for a knowledge chunk to be used in an answer (0–1).
# Higher = stricter, fewer but more relevant citations. text-embedding-3-small
# produces ~0.6–0.7 for good matches and ~0.3–0.45 for weak-but-real ones, so
# 0.35 keeps genuine hits while literal name matches are grounded separately.
RAG_SIMILARITY_THRESHOLD=0.35
# Max chunks any single article may contribute to one answer (keeps big books
# from crowding out other sources).
RAG_MAX_CHUNKS_PER_ARTICLE=3

# Partner knowledge base (files uploaded by a partner, used only for their own
# requests). Retrieval is deliberately tighter than the shared library.
PARTNER_RAG_MAX_CHUNKS=4
PARTNER_RAG_MAX_CHUNKS_PER_FILE=2
PARTNER_RAG_SIMILARITY_THRESHOLD=0.35

# Consumer app (B2C) — linked from auth pages and footer
NEXT_PUBLIC_CONSUMER_APP_URL=https://tanyalahustaz.com/home
